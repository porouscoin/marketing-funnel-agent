# Models (at least one). Only models with a key are used.
GEMINI_API_KEY=
GROQ_API_KEY=
# Competitor search
TAVILY_API_KEY=
# Which models write and which play the buyers, in order of preference
WRITER_MODELS=gemini,gpt-oss-120b,qwen
BUYER_MODELS=gemini,gpt-oss-120b,qwen,gpt-oss-20b
SCORE_BAR=6
RUNS_PER_DAY=3
FRONTEND_ORIGIN=http://localhost:3000
# Local development without keys
ENABLE_MOCK_MODEL=1
